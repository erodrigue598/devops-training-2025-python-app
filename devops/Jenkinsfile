
pipeline {
    agent any

    stages {

        // =========================
        // Checkout
        // =========================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // =========================
        // Construir imagen CI (usando ci.Dockerfile)
        // =========================
        stage('CI - Build tools image') {
            steps {
                script {
                    // Nombre dinámico para evitar colisiones
                    env.CI_IMAGE_NAME = "python-ci-tools:${env.BUILD_NUMBER}"

                    // Construir la imagen desde devops/ci.Dockerfile
                    docker.build(env.CI_IMAGE_NAME, "-f devops/ci.Dockerfile .")
                }
            }
        }

        // =========================
        // Lint (instalando deps dentro del stage)
        // =========================
        stage('CI - Lint') {
            agent {
                docker {
                    image "${env.CI_IMAGE_NAME}"
                }
            }
            steps {
                sh 'pip install -r requirements.txt flake8 mypy'
                sh 'make lint'
            }
        }

        // =========================
        // Test (instalando deps dentro del stage)
        // =========================
        stage('CI - Test') {
            agent {
                docker {
                    image "${env.CI_IMAGE_NAME}"
                }
            }
            steps {
                sh 'pip install -r requirements.txt'
                sh 'make test'
            }
        }

        // =========================
        // Info
        // =========================
        stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build ${env.BUILD_NUMBER}"
            }
        }
    }
}
