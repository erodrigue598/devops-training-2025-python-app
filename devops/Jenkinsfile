pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

     
        stage('Lint') {
            agent {
                docker {
                    image 'python-ci:3.6'
                }
            }
            steps {
                sh 'make lint'
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'python-ci:3.6'
                }
            }
            steps {
                sh 'make test'
            }
        }

        
        
            stage('Info'){
            steps{ 
                  echo "Job: ${env.JOB_NAME}"
                  echo "Build ${env.BUILD_NUMBER}"

               }
            }
/*    
